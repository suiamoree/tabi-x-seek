# ── Wajib ─────────────────────────────────────────────────────────────────────
# Password untuk semua akun GitHub yang dibuat.
GITHUB_PASSWORD=

# Dashboard 9router. Port 20127 (bukan 20128).
# Hanya dipakai kalau hasilnya dikirim ke 9router — pilihan itu ada di CLI, dan
# "akun.txt saja" jalan tanpa mengisi NINEROUTER_PASSWORD.
NINEROUTER_URL=http://192.168.0.105:20127
NINEROUTER_PASSWORD=

# ── Temp-mail ─────────────────────────────────────────────────────────────────
# worker = inbox pribadi (Cloudflare Worker + D1), auth Bearer password.
#   Direkomendasikan: domain sendiri tidak dipakai orang lain.
# mailtm = https://api.mail.tm — gratis, tanpa API key, batas 8 request/detik.
#   Ketentuan pakai mail.tm meminta atribusi balik ke mail.tm bila API dipakai.
#   PERINGATAN: akun GitHub yang dibuat dengan domain mail.tm langsung kena ban
#   setelah registrasi. Pakai ini hanya untuk mengetes alur script.
MAIL_PROVIDER=worker
# URL Worker milikmu sendiri, contoh https://temp-mail.namamu.workers.dev
# Wajib bila MAIL_PROVIDER=worker — tidak ada default.
MAIL_WORKER_URL=
# Sama dengan APP_PASSWORD di Worker secret (produksi) atau .dev.vars (lokal).
# Password mentah, bukan hash/base64. Wajib bila MAIL_PROVIDER=worker.
MAIL_WORKER_PASSWORD=
MAILTM_BASE_URL=https://api.mail.tm

# ── Proxy DataImpulse (opsional) ───────────────────────────────────────────────
# PROXY_ENABLED=0 → jalan tanpa proxy, tidak membakar kuota bandwidth.
# Satu browser = satu sessid = satu IP. Challenge Cloudflare butuh IP stabil dari
# awal sampai akhir, jadi jangan pakai port rotating tanpa sessid.
# Username final: {PROXY_USER}__cr.{PROXY_COUNTRY};sessid.{id}
PROXY_ENABLED=0
PROXY_USER=
PROXY_PASS=
PROXY_HOST=gw.dataimpulse.com:823
# Kode negara 2 huruf, kosongkan untuk mana saja. Contoh: id
PROXY_COUNTRY=

# ── Opsional ──────────────────────────────────────────────────────────────────
# Model default yang disimpan bersama tiap connection di 9router.
DEFAULT_MODEL=claude-opus-5-thinking

# Browser display (Linux only). Mode tampilan browser (non-headless / virtual
# display Xvfb / headless) dipilih di CLI tiap kali run, bukan di sini.
# DISPLAY=:0
# WAYLAND_DISPLAY=wayland-0
